{
  "$id": "https://github.com/psagar29/Antibody/schemas/publication-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "commitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "draft": {
      "const": true,
      "type": "boolean"
    },
    "pullRequestNumber": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "pullRequestUrl": {
      "format": "uri",
      "pattern": "^https:\\/\\/github\\.com\\/.*",
      "type": "string"
    },
    "receiptSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "cloneUrl": {
          "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\.git$",
          "type": "string"
        },
        "slug": {
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "cloneUrl"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "antibody.publication/v1",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "receiptSha256",
    "repository",
    "branch",
    "commitSha",
    "pullRequestNumber",
    "pullRequestUrl",
    "draft",
    "createdAt"
  ],
  "type": "object"
}
