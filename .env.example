# Required for live Reflex authoring.
REFLEX_API_KEY=
REFLEX_BASE_URL=
REFLEX_ORGANIZATION_ID=
ANTIBODY_REFLEX_PERSONA_ID=

# Required for live Runloop verification.
RUNLOOP_API_KEY=
ANTIBODY_RUNLOOP_SNAPSHOT_ID=
ANTIBODY_RUNLOOP_NETWORK_POLICY_ID=

# Optional alternative when .antibody.yml selects a Runloop blueprint.
ANTIBODY_RUNLOOP_BLUEPRINT_ID=

# Optional for private mounts; required for GitHub publication.
GITHUB_TOKEN=
